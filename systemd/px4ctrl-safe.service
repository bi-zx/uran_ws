[Unit]
Description=PX4Ctrl safe startup gate
After=network-online.target uran-autostart.service
Wants=network-online.target uran-autostart.service

[Service]
Type=simple
User=jetson
SupplementaryGroups=dialout tty
WorkingDirectory=/home/jetson/uran_ws
Environment=WORKSPACE_DIR=/home/jetson/uran_ws
Environment=ROS_DISTRO=noetic
Environment=EXTRA_SETUP_FILES=/home/jetson/catkin_pkg/devel/setup.bash
Environment=ROS_HOME=/tmp/ros_home
Environment=ROS_LOG_DIR=/tmp/ros_home/log
Environment=PX4CTRL_RC_STABLE_SECONDS=2.0
Environment=PX4CTRL_RC_CHECK_TIMEOUT=0
ExecStart=/home/jetson/uran_ws/scripts/start_px4ctrl_safe.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
